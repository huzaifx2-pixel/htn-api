# Existing application settings
PORT=3000
DATABASE_URL=

# Cloudflare R2 S3 API credentials
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional. Defaults to 900 seconds (15 minutes), capped at 7 days.
R2_PRESIGNED_URL_EXPIRES_SECONDS=900

# SerpAPI search provider (Talent Discovery)
SERPAPI_API_KEY=
# Optional. Request timeout in milliseconds. Defaults to 15000.
SERPAPI_TIMEOUT_MS=15000
# Optional. Number of results per page (1-10). Defaults to 10.
SERPAPI_RESULTS_PER_PAGE=10

# Micro1 referral sync (ATS Sync from HTN Now + /api/ingest)
SYNC_API_KEY=
MICRO1_REFERRAL_EMAIL=
MICRO1_REFERRAL_TOKEN=
# Optional. Prefer explicit referral code; otherwise decoded from token JWT id.
MICRO1_REFERRAL_CODE=
MICRO1_TIMEZONE=

# ATS → careers publish (PUT /integrations/ats/jobs/:atsJobId)
HTN_ATS_INTEGRATION_KEY=
